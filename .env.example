# ==============================================================================
# LiteLLM Proxy / Zoo Code 環境変数設定ファイル (.env.example)
# ==============================================================================
#
# 【設定手順】
# 1. このファイルを .env にコピーします。
#    cp .env.example .env
# 2. 必要な各項目に実際の値を入力します。
# 3. .env には秘密情報が含まれるため、Git にコミットしないでください（.gitignore 済）。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OpenRouter API 設定
# ------------------------------------------------------------------------------
# OpenRouter (https://openrouter.ai/) の API キーを設定します。
# update_config.py によるモデル一覧・利用量データの取得、および LiteLLM 経由での
# OpenRouter モデル呼び出しに使用されます。
#
# 記述例: OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY=

# ------------------------------------------------------------------------------
# 2. LiteLLM Proxy 認証・管理設定
# ------------------------------------------------------------------------------
# LiteLLM Proxy のマスターキーを設定します。
# クライアント（VS Code, Zoo Code, curl 等）から LiteLLM にアクセスする際の
# Bearer トークン（認証キー）として使用します。
# 推奨: ランダムで十分な長さの文字列（英数字記号）。
#
# 記述例: LITELLM_MASTER_KEY=sk-my-custom-proxy-key-12345
LITELLM_MASTER_KEY=

# ------------------------------------------------------------------------------
# 3. PostgreSQL データベース設定 (Docker Compose 用)
# ------------------------------------------------------------------------------
# LiteLLM のモデルデータや利用状況を永続化するための PostgreSQL 接続情報です。
# docker-compose.yml 起動時にコンテナへ渡されます。
#
# 記述例:
#   POSTGRES_DB=litellm_db
#   POSTGRES_USER=litellm_user
#   POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=litellm_db
POSTGRES_USER=litellm_user
POSTGRES_PASSWORD=

# ------------------------------------------------------------------------------
# 4. Discord 通知設定 (任意)
# ------------------------------------------------------------------------------
# update_config.py 実行時に、選定されたモデル一覧（Popularity, Practical, Great Deal）
# を Discord チャンネルへ Embed 形式で通知するための Webhook URL です。
# 通知が不要な場合は空欄のままで問題ありません。
#
# 記述例: DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/xxxx
DISCORD_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 5. ModelGrep 連携設定 (任意)
# ------------------------------------------------------------------------------
# ModelGrep API (https://modelgrep.com/) は知性・コーディングベンチマークの
# 取得のために常時利用されます（Practical カテゴリ等の判定に使用）。
# 以下の設定は、ログや Discord 通知に「詳細な比較レポート」を出力するかどうかを制御します。
#
# MODELGREP_COMPARE_ENABLED:
#   1 = Discord/ログに詳細なベンチマーク比較レポートを出力する
#   0 = 出力しない（デフォルト）
MODELGREP_COMPARE_ENABLED=0

# ModelGrep API から一度に取得するモデル件数（通常は 200 のままで問題ありません）
MODELGREP_COMPARE_LIMIT=200

# レポートに表示する ModelGrep 全体ランキングの上位件数（1〜10）
MODELGREP_COMPARE_TOP=5
